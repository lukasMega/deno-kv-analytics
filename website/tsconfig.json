// This file is not used by "docusaurus start/build" commands.
// It is here to improve your IDE experience (type-checking, autocompletion...),
// and can also run the package.json "typecheck" script manually.
//
// @docusaurus/tsconfig (3.10.2) is inlined rather than extended: it sets
// "baseUrl", which TypeScript 7 removed (TS5102), and an extending config
// cannot unset an inherited option. Its "@site/*" -> "./*" mapping also only
// worked via that baseUrl override; declared here it anchors to this file's
// directory directly. Re-check on the next Docusaurus release.
{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "paths": {
      "@site/*": ["./*"]
    },
    "skipLibCheck": true,
    "strict": true
  },
  "exclude": [".docusaurus", "build"]
}
